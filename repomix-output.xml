<file path="AutoVision/Cognitive-Automation/pluely/src/pages/chats/components/ModelSwitcher.tsx">
import { useState, useEffect, useMemo } from "react";
import {
    DropdownMenu,
    DropdownMenuContent,
    DropdownMenuItem,
    DropdownMenuLabel,
    DropdownMenuSeparator,
    DropdownMenuSub,
    DropdownMenuSubContent,
    DropdownMenuSubTrigger,
    DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import { Button } from "@/components/ui/button";
import { ChevronDown, RefreshCwIcon, Loader2Icon, SparklesIcon, BrainIcon, CheckIcon } from "lucide-react";
import { useApp } from "@/contexts";
import { fetch as tauriFetch } from "@tauri-apps/plugin-http";
import curl2Json from "@bany/curl-to-json";
import { getProfiles } from "@/lib/storage/model-profiles.storage";
import { getSuggestedProfileForModel } from "@/config";

interface ModelSwitcherProps {
    currentProviderId?: string;
    currentModel?: string;
    currentProfileId?: string;
    onSwitch: (providerId: string, model: string, profileId?: string) => void;
}

interface ProviderModels {
    providerId: string;
    providerName: string;
    models: string[];
    isLoading: boolean;
}

export const ModelSwitcher = ({
    currentProviderId,
    currentModel,
    currentProfileId,
    onSwitch,
}: ModelSwitcherProps) => {
    const { allAiProviders, selectedAIProvider } = useApp();
    const [providerModels, setProviderModels] = useState<Map<string, ProviderModels>>(new Map());
    const [isOpen, setIsOpen] = useState(false);
    const [selectedProfileId, setSelectedProfileId] = useState<string | undefined>(currentProfileId);

    // Load profiles
    const profiles = useMemo(() => getProfiles(), []);

    // Update profile when model changes
    useEffect(() => {
        if (currentModel && !currentProfileId) {
            const suggestedId = getSuggestedProfileForModel(currentModel);
            setSelectedProfileId(suggestedId);
        } else {
            setSelectedProfileId(currentProfileId);
        }
    }, [currentModel, currentProfileId]);

    // Get current profile name
    const currentProfileName = useMemo(() => {
        const profile = profiles.find(p => p.id === selectedProfileId);
        return profile?.name || "Auto";
    }, [profiles, selectedProfileId]);

    // Determine display values
    const effectiveProviderId = currentProviderId || selectedAIProvider?.provider;
    const effectiveModel = currentModel || selectedAIProvider?.variables?.model;

    // Get provider name for display
    const getProviderName = (providerId: string): string => {
        const provider = allAiProviders?.find((p) => p?.id === providerId);
        if (!provider) return providerId;
        if (provider.isCustom) {
            try {
                const json = curl2Json(provider.curl);
                return json?.url ? new URL(json.url).hostname : "Custom";
            } catch {
                return "Custom";
            }
        }
        return provider.name || provider.id || "Unknown";
    };

    // Fetch models for a specific provider
    const fetchModelsForProvider = async (providerId: string): Promise<string[]> => {
        try {
            const provider = allAiProviders?.find((p) => p?.id === providerId);
            if (!provider) return [];

            let baseUrl = "";
            let apiKey = "";

            try {
                const curlJson = curl2Json(provider.curl);
                const url = curlJson.url;

                // Extract Base URL
                if (url.includes("/chat/completions")) {
                    baseUrl = url.split("/chat/completions")[0];
                } else if (url.includes("/completions")) {
                    baseUrl = url.split("/completions")[0];
                } else {
                    const urlObj = new URL(url);
                    baseUrl = `${urlObj.protocol}//${urlObj.host}/v1`;
                }

                // Extract API Key
                apiKey = provider.variables?.API_KEY || provider.variables?.api_key || "";

                if (!apiKey && curlJson.header) {
                    const authHeader = curlJson.header["Authorization"];
                    if (authHeader && authHeader.includes("Bearer ")) {
                        const parts = authHeader.split("Bearer ");
                        if (parts.length > 1 && !parts[1].includes("{{")) {
                            apiKey = parts[1];
                        }
                    }
                }
            } catch (e) {
                console.warn("Failed to parse cURL for model fetching", e);
                if (providerId === "lm-studio") baseUrl = "http://localhost:1234/v1";
            }

            if (!baseUrl) return [];

            const modelsUrl = `${baseUrl}/models`;
            const headers: Record<string, string> = {
                "Content-Type": "application/json",
            };

            if (apiKey && !apiKey.includes("{{")) {
                headers["Authorization"] = `Bearer ${apiKey}`;
            }

            const isLocal = modelsUrl.includes("localhost") || modelsUrl.includes("127.0.0.1");
            const fetchFn = isLocal ? fetch : tauriFetch;

            const response = await fetchFn(modelsUrl, {
                method: "GET",
                headers,
            });

            if (!response.ok) return [];

            const data = await response.json();
            return data.data?.map((m: any) => m.id) || [];
        } catch (error) {
            console.error("Error fetching models:", error);
            return [];
        }
    };

    // Load models when dropdown opens
    const handleOpenChange = async (open: boolean) => {
        setIsOpen(open);
        if (open) {
            // Start loading models for all providers
            for (const provider of allAiProviders || []) {
                if (!provider?.id) continue;
                const existing = providerModels.get(provider.id);
                if (existing && existing.models.length > 0) continue; // Already loaded

                // Mark as loading
                setProviderModels((prev) => {
                    const next = new Map(prev);
                    next.set(provider.id!, {
                        providerId: provider.id!,
                        providerName: getProviderName(provider.id!),
                        models: [],
                        isLoading: true,
                    });
                    return next;
                });

                // Fetch models
                fetchModelsForProvider(provider.id).then((models) => {
                    setProviderModels((prev) => {
                        const next = new Map(prev);
                        next.set(provider.id!, {
                            providerId: provider.id!,
                            providerName: getProviderName(provider.id!),
                            models: models.length > 0 ? models : [selectedAIProvider?.variables?.model || "default"],
                            isLoading: false,
                        });
                        return next;
                    });
                });
            }
        }
    };

    // Refresh models for a provider
    const refreshProvider = async (providerId: string, e: React.MouseEvent) => {
        e.stopPropagation();
        e.preventDefault();

        setProviderModels((prev) => {
            const next = new Map(prev);
            const existing = next.get(providerId);
            if (existing) {
                next.set(providerId, { ...existing, isLoading: true });
            }
            return next;
        });

        const models = await fetchModelsForProvider(providerId);
        setProviderModels((prev) => {
            const next = new Map(prev);
            next.set(providerId, {
                providerId,
                providerName: getProviderName(providerId),
                models: models.length > 0 ? models : ["default"],
                isLoading: false,
            });
            return next;
        });
    };

    const handleModelSelect = (providerId: string, model: string) => {
        // Auto-suggest a profile based on the model
        const suggestedProfileId = getSuggestedProfileForModel(model);
        setSelectedProfileId(suggestedProfileId);
        onSwitch(providerId, model, suggestedProfileId);
        setIsOpen(false);
    };

    const handleProfileSelect = (profileId: string) => {
        setSelectedProfileId(profileId);
        // Re-trigger with current model and new profile
        if (effectiveProviderId && effectiveModel) {
            onSwitch(effectiveProviderId, effectiveModel, profileId);
        }
        setIsOpen(false);
    };

    return (
        <DropdownMenu open={isOpen} onOpenChange={handleOpenChange}>
            <DropdownMenuTrigger asChild>
                <Button
                    variant="outline"
                    size="sm"
                    className="text-[10px] lg:text-sm h-6 lg:h-8 gap-1 max-w-[180px]"
                >
                    <SparklesIcon className="size-3 lg:size-4 shrink-0" />
                    <span className="truncate">
                        {effectiveProviderId
                            ? `${getProviderName(effectiveProviderId)}${effectiveModel ? ` / ${effectiveModel}` : ""}`
                            : "Select Model"}
                    </span>
                    <ChevronDown className="size-3 lg:size-4 shrink-0 opacity-50" />
                </Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="start" className="w-64">
                <DropdownMenuLabel className="text-xs text-muted-foreground">
                    Switch AI Model
                </DropdownMenuLabel>
                <DropdownMenuSeparator />
                {allAiProviders?.map((provider) => {
                    if (!provider?.id) return null;
                    const models = providerModels.get(provider.id);
                    const isCurrentProvider = provider.id === effectiveProviderId;

                    return (
                        <DropdownMenuSub key={provider.id}>
                            <DropdownMenuSubTrigger
                                className={`cursor-pointer ${isCurrentProvider ? "bg-accent/50" : ""}`}
                            >
                                <div className="flex items-center justify-between w-full">
                                    <span className="truncate">{getProviderName(provider.id)}</span>
                                    {models?.isLoading && (
                                        <Loader2Icon className="size-3 animate-spin ml-2" />
                                    )}
                                </div>
                            </DropdownMenuSubTrigger>
                            <DropdownMenuSubContent className="max-h-64 overflow-y-auto">
                                <div className="flex items-center justify-between px-2 py-1">
                                    <span className="text-xs text-muted-foreground">Models</span>
                                    <Button
                                        variant="ghost"
                                        size="icon"
                                        className="size-5"
                                        onClick={(e) => refreshProvider(provider.id!, e)}
                                        disabled={models?.isLoading}
                                    >
                                        {models?.isLoading ? (
                                            <Loader2Icon className="size-3 animate-spin" />
                                        ) : (
                                            <RefreshCwIcon className="size-3" />
                                        )}
                                    </Button>
                                </div>
                                <DropdownMenuSeparator />
                                {models?.models && models.models.length > 0 ? (
                                    models.models.map((model) => (
                                        <DropdownMenuItem
                                            key={model}
                                            onClick={() => handleModelSelect(provider.id!, model)}
                                            className={`cursor-pointer ${isCurrentProvider && model === effectiveModel
                                                ? "bg-primary/10 font-medium"
                                                : ""
                                                }`}
                                        >
                                            <span className="truncate">{model}</span>
                                        </DropdownMenuItem>
                                    ))
                                ) : (
                                    <div className="px-2 py-2 text-xs text-muted-foreground">
                                        {models?.isLoading ? "Loading..." : "No models available"}
                                    </div>
                                )}
                            </DropdownMenuSubContent>
                        </DropdownMenuSub>
                    );
                })}
                {/* Profile Selector */}
                <DropdownMenuSeparator />
                <DropdownMenuSub>
                    <DropdownMenuSubTrigger className="cursor-pointer">
                        <div className="flex items-center gap-2 w-full">
                            <BrainIcon className="size-3" />
                            <span>Profile: {currentProfileName}</span>
                        </div>
                    </DropdownMenuSubTrigger>
                    <DropdownMenuSubContent>
                        <DropdownMenuLabel className="text-xs text-muted-foreground">
                            Select Profile
                        </DropdownMenuLabel>
                        <DropdownMenuSeparator />
                        {profiles.map((profile) => (
                            <DropdownMenuItem
                                key={profile.id}
                                onClick={() => handleProfileSelect(profile.id)}
                                className={`cursor-pointer ${profile.id === selectedProfileId ? "bg-primary/10 font-medium" : ""}`}
                            >
                                <div className="flex items-center justify-between w-full gap-2">
                                    <span className="truncate">{profile.name}</span>
                                    {profile.id === selectedProfileId && (
                                        <CheckIcon className="size-3 text-primary" />
                                    )}
                                </div>
                            </DropdownMenuItem>
                        ))}
                    </DropdownMenuSubContent>
                </DropdownMenuSub>
            </DropdownMenuContent>
        </DropdownMenu>
    );
};
</file>

<file path="AutoVision/Cognitive-Automation/pluely/src/pages/chats/components/View.tsx">
import {
  Badge,
  Card,
  Empty,
  Button,
  Markdown,
  Textarea,
  GetLicense,
} from "@/components";
import { getConversationById } from "@/lib";
import { ChatConversation } from "@/types";
import {
  Download,
  MessageCircleIcon,
  MessageCircleReplyIcon,
  Trash2,
  SparklesIcon,
  UserIcon,
  SendIcon,
  Check,
  Loader2,
} from "lucide-react";
import { useState, useEffect } from "react";
import moment from "moment";
import { useParams, useNavigate } from "react-router-dom";
import { PageLayout } from "@/layouts";
import { useHistory, useChatCompletion } from "@/hooks";
import { useApp } from "@/contexts";
import {
  DeleteConfirmationDialog,
  ChatAudio,
  ChatScreenshot,
  ChatFiles,
  AudioRecorder,
  ModelSwitcher,
} from ".";
import { ArrowRightIcon } from "lucide-react";
import { saveConversation, generateMessageId } from "@/lib";

const View = () => {
  const { conversationId } = useParams();
  const { hasActiveLicense } = useApp();
  const navigate = useNavigate();
  const [messages, setMessages] = useState<ChatConversation | null>(null);

  const {
    handleDeleteConfirm,
    confirmDelete,
    cancelDelete,
    deleteConfirm,
    handleAttachToOverlay,
    handleDownload,
    isDownloaded,
    isAttached,
  } = useHistory();

  const completion = useChatCompletion(
    conversationId as string,
    messages,
    setMessages
  );

  useEffect(() => {
    const getMessages = async () => {
      const conversation = await getConversationById(conversationId as string);
      setMessages(conversation || null);
    };
    getMessages();
  }, [conversationId]);

  useEffect(() => {
    // Scroll to bottom when messages load
    if (messages?.messages.length) {
      setTimeout(() => {
        completion.messagesEndRef.current?.scrollIntoView({
          behavior: "smooth",
        });
      }, 100);
    }
  }, [messages?.messages.length]);

  const handleDelete = async () => {
    await confirmDelete();
    navigate(-1);
  };

  // Handle model switch - creates visual divider and updates conversation
  const handleModelSwitch = async (newProviderId: string, newModel: string) => {
    if (!messages || !conversationId) return;

    const currentProviderId = messages.providerId;
    const currentModel = messages.model;

    // Don't switch if same model
    if (currentProviderId === newProviderId && currentModel === newModel) return;

    // Create model switch message with metadata
    const timestamp = Date.now();
    const switchMessage = {
      id: generateMessageId("system", timestamp),
      role: "system" as const,
      content: "",  // Empty content - rendered as visual divider
      timestamp,
      metadata: {
        type: "model_switch" as const,
        fromProvider: currentProviderId,
        fromModel: currentModel,
        toProvider: newProviderId,
        toModel: newModel,
      },
    };

    // Update conversation with new provider/model and add switch message
    const updatedConversation = {
      ...messages,
      providerId: newProviderId,
      model: newModel,
      messages: [...messages.messages, switchMessage],
      updatedAt: timestamp,
    };

    // Update UI immediately
    setMessages(updatedConversation);

    // Save to database
    try {
      await saveConversation(updatedConversation);
    } catch (error) {
      console.error("Failed to save model switch:", error);
    }
  };

  return (
    <PageLayout
      isMainTitle={false}
      allowBackButton={true}
      title={messages?.title || ""}
      description={`${messages?.messages.length} messages in this conversation`}
      rightSlot={
        <div className="flex flex-row items-center gap-2">
          <ModelSwitcher
            currentProviderId={messages?.providerId}
            currentModel={messages?.model}
            onSwitch={handleModelSwitch}
          />
          <Button
            variant="outline"
            title="Open this conversation in overlay"
            className="text-[10px] lg:text-sm h-6 lg:h-8"
            onClick={() =>
              conversationId && handleAttachToOverlay(conversationId)
            }
            disabled={isAttached}
          >
            {isAttached ? (
              <>
                <Check className="size-3 lg:size-4 text-green-600" />
                Attached
              </>
            ) : (
              <>
                Open in Overlay{" "}
                <MessageCircleReplyIcon className="size-3 lg:size-4" />
              </>
            )}
          </Button>
          <Button
            variant={"outline"}
            title="Download conversation as markdown"
            className="text-[10px] lg:text-sm h-6 lg:h-8"
            onClick={(e) => handleDownload(messages, e)}
            disabled={isDownloaded}
          >
            {isDownloaded ? (
              <>
                <Check className="size-3 lg:size-4 text-green-600" />
                Downloaded
              </>
            ) : (
              <>
                Download <Download className="size-3 lg:size-4" />
              </>
            )}
          </Button>
          <Button
            variant="destructive"
            title="Delete conversation"
            onClick={() =>
              conversationId && handleDeleteConfirm(conversationId)
            }
            className="text-[10px] lg:text-sm h-6 lg:h-8"
          >
            Delete <Trash2 className="size-3 lg:size-4" />
          </Button>
        </div>
      }
    >
      {messages?.messages.length === 0 ? (
        <Empty
          isLoading={false}
          icon={MessageCircleIcon}
          title="No messages found"
          description="Start a new message to get started"
        />
      ) : (
        <div className="flex flex-col gap-4 pb-24 px-2">
          {messages?.messages.map((message, index, array) => {
            const isUser = message.role === "user";
            const showDate =
              index === 0 ||
              moment(message.timestamp).format("YYYY-MM-DD") !==
              moment(array[index - 1]?.timestamp).format("YYYY-MM-DD");

            // Check if this is a model switch message
            const isModelSwitch = message.metadata?.type === "model_switch";

            return (
              <div key={message.id}>
                {/* Date separator */}
                {showDate && (
                  <Badge
                    variant={"outline"}
                    className="flex items-center justify-center my-4 w-fit mx-auto"
                  >
                    {moment(message.timestamp).format("ddd, MMM D")}
                  </Badge>
                )}

                {/* Model Switch Visual Divider */}
                {isModelSwitch && (
                  <div className="flex items-center justify-center gap-2 my-4 px-4">
                    <div className="flex-1 h-px bg-border" />
                    <div className="flex items-center gap-2 px-3 py-1 rounded-full bg-muted/50 border border-border text-xs text-muted-foreground">
                      <span className="font-medium">
                        {message.metadata?.fromProvider || "Unknown"}
                        {message.metadata?.fromModel && ` / ${message.metadata.fromModel}`}
                      </span>
                      <ArrowRightIcon className="size-3" />
                      <span className="font-medium text-primary">
                        {message.metadata?.toProvider || "Unknown"}
                        {message.metadata?.toModel && ` / ${message.metadata.toModel}`}
                      </span>
                    </div>
                    <div className="flex-1 h-px bg-border" />
                  </div>
                )}

                {/* Message - Skip rendering for model_switch messages (they only show divider) */}
                {!isModelSwitch && (
                  <div
                    className={`flex gap-3 ${isUser ? "justify-end" : "justify-start"
                      }`}
                  >
                    {/* Avatar - Left side for bot */}
                    {!isUser && (
                      <div className="flex-shrink-0">
                        <div className="size-7 lg:size-8 rounded-full bg-primary/10 flex items-center justify-center">
                          <SparklesIcon className="size-3 lg:size-4 text-primary" />
                        </div>
                      </div>
                    )}

                    {/* Message content */}
                    <div
                      className={`flex flex-col gap-1 max-w-[70%] ${isUser ? "items-end" : "items-start"
                        }`}
                    >
                      <Card
                        className={`px-4 text-xs lg:text-sm py-0 transition-all select-none shadow-none ${isUser
                          ? "!bg-primary text-primary-foreground !border-primary rounded-tr-sm"
                          : "!bg-muted/50 dark:!bg-muted/30 rounded-tl-sm"
                          }`}
                      >
                        <Markdown>{message.content}</Markdown>
                        {/* Attachments */}
                        {message.attachedFiles && message.attachedFiles.length > 0 && (
                          <div className="flex flex-col gap-2 mt-2">
                            {message.attachedFiles.map((file, i) => (
                              <div key={i} className="rounded-md overflow-hidden">
                                {file.type.startsWith("image/") ? (
                                  <img
                                    src={`data:${file.type};base64,${file.base64}`}
                                    alt={file.name}
                                    className="max-w-full h-auto max-h-[200px] object-cover rounded-md"
                                  />
                                ) : file.type.startsWith("audio/") ? (
                                  <audio
                                    controls
                                    src={`data:${file.type};base64,${file.base64}`}
                                    className="w-full"
                                  />
                                ) : null}
                              </div>
                            ))}
                          </div>
                        )}
                      </Card>
                      <Badge
                        variant="outline"
                        className={`text-[10px] lg:text-xs bg-transparent border-none ${isUser ? "-mr-1" : "-ml-1"
                          }`}
                      >
                        {moment(message.timestamp).format("hh:mm A")}
                      </Badge>
                    </div>

                    {/* Avatar - Right side for user */}
                    {isUser && (
                      <div className="flex-shrink-0">
                        <div className="size-7 lg:size-8 rounded-full bg-primary flex items-center justify-center">
                          <UserIcon className="size-3 lg:size-4 text-primary-foreground" />
                        </div>
                      </div>
                    )}
                  </div>
                )}
              </div>
            );
          })}
          <div ref={completion.messagesEndRef} />
        </div>
      )}

      {/* Sticky Footer Input */}
      <div className="absolute bottom-0 left-0 right-0 bg-background/10 backdrop-blur">
        {completion.error && (
          <div className="px-4 pt-3 pb-0">
            <div className="p-2 bg-destructive/10 border border-destructive/20 rounded text-sm text-destructive">
              <strong>Error:</strong> {completion.error}
            </div>
          </div>
        )}

        <div className="relative flex items-start gap-2 p-4">
          {!hasActiveLicense && (
            <div className="select-none p-5 z-100 bg-primary/5 border border-primary/20 rounded-xl absolute top-4 left-4 right-4">
              <div className="max-w-sm mx-auto">
                <p className="text-sm font-medium text-center">
                  You need an active license to use this feature.
                </p>

                <GetLicense
                  buttonText="Get License"
                  buttonClassName="w-full mt-2"
                />
              </div>
            </div>
          )}
          <div className="flex-1 relative">
            {completion.isRecording ? (
              <AudioRecorder
                onTranscriptionComplete={(text) => {
                  completion.setIsRecording(false);
                  completion.submit(text);
                }}
                onCancel={() => completion.setIsRecording(false)}
              />
            ) : (
              <>
                <div className="absolute bottom-2 left-2 flex items-center gap-1 z-10">
                  <ChatFiles
                    attachedFiles={completion.attachedFiles}
                    handleFileSelect={completion.handleFileSelect}
                    removeFile={completion.removeFile}
                    onRemoveAllFiles={completion.onRemoveAllFiles}
                    isLoading={completion.isLoading}
                    isFilesPopoverOpen={completion.isFilesPopoverOpen}
                    setIsFilesPopoverOpen={completion.setIsFilesPopoverOpen}
                    disabled={!hasActiveLicense}
                  />
                  <ChatAudio
                    micOpen={completion.micOpen}
                    setMicOpen={completion.setMicOpen}
                    isRecording={completion.isRecording}
                    setIsRecording={completion.setIsRecording}
                    disabled={!hasActiveLicense}
                  />
                  <ChatScreenshot
                    screenshotConfiguration={completion.screenshotConfiguration}
                    attachedFiles={completion.attachedFiles}
                    isLoading={completion.isLoading}
                    captureScreenshot={completion.captureScreenshot}
                    isScreenshotLoading={completion.isScreenshotLoading}
                    disabled={!hasActiveLicense}
                  />
                </div>

                <Textarea
                  ref={completion.inputRef}
                  placeholder="Type a message..."
                  className="pr-12 pl-2 resize-none pb-12 pt-3"
                  rows={2}
                  value={completion.input}
                  onChange={(e) => completion.setInput(e.target.value)}
                  onKeyDown={completion.handleKeyPress}
                  onPaste={completion.handlePaste}
                  disabled={completion.isLoading || !hasActiveLicense}
                />
                <Button
                  size="icon"
                  className="size-7 lg:size-9 rounded-lg lg:rounded-xl absolute right-2 bottom-2"
                  title="Send message"
                  onClick={() => completion.submit()}
                  disabled={
                    completion.isLoading ||
                    !completion.input.trim() ||
                    !hasActiveLicense
                  }
                >
                  {completion.isLoading ? (
                    <Loader2 className="size-3 lg:size-4 animate-spin" />
                  ) : (
                    <SendIcon className="size-3 lg:size-4" />
                  )}
                </Button>
              </>
            )}
          </div>
        </div>
      </div>

      {/* Delete Confirmation Dialog */}
      <DeleteConfirmationDialog
        deleteConfirm={deleteConfirm}
        cancelDelete={cancelDelete}
        confirmDelete={handleDelete}
      />
    </PageLayout>
  );
};

export default View;
</file>

<file path="AutoVision/Cognitive-Automation/pluely/src/pages/chats/index.tsx">
import { Badge, Input, Card, Empty, Button } from "@/components";
import { useHistory } from "@/hooks";
import { PageLayout } from "@/layouts";
import { MessageCircleIcon, Search, Trash2 } from "lucide-react";
import moment from "moment";
import { useNavigate } from "react-router-dom";
import { DeleteConfirmationDialog } from "./components";
import { useState } from "react";

const Dashboard = () => {
  const conversations = useHistory();
  const navigate = useNavigate();
  const [clearAllConfirm, setClearAllConfirm] = useState(false);

  // Group conversations by date
  const groupedConversations = conversations.conversations.reduce(
    (acc, doc) => {
      const dateKey = moment(doc.updatedAt).format("YYYY-MM-DD");
      if (!acc[dateKey]) {
        acc[dateKey] = [];
      }
      acc[dateKey].push(doc);
      return acc;
    },
    {} as Record<string, typeof conversations.conversations>
  );

  // Sort dates in descending order (most recent first)
  const sortedDates = Object.keys(groupedConversations).sort((a, b) =>
    moment(b).diff(moment(a))
  );

  return (
    <PageLayout
      title="All conversations"
      description="View all your conversations"
    >
      <>
        {conversations.conversations.length === 0 ? (
          <Empty
            isLoading={conversations.isLoading}
            icon={MessageCircleIcon}
            title="No conversations found"
            description="Start a new conversation to get started"
          />
        ) : (
          <div className="flex flex-col gap-6 pb-8">
            <div className="flex items-center gap-4 mb-4">
              <div className="relative flex-1 max-w-xs">
                <Search className="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
                <Input
                  type="text"
                  placeholder="Search conversations..."
                  className="pl-9 focus-visible:ring-0 focus-visible:ring-offset-0"
                  value={conversations.search}
                  onChange={(e) => conversations.setSearch(e.target.value)}
                />
              </div>
              {/* Clear All Button */}
              {clearAllConfirm ? (
                <div className="flex items-center gap-2">
                  <span className="text-sm text-muted-foreground">Delete all?</span>
                  <Button
                    variant="destructive"
                    size="sm"
                    onClick={async () => {
                      await conversations.clearAllConversations();
                      setClearAllConfirm(false);
                    }}
                  >
                    Yes, Clear All
                  </Button>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => setClearAllConfirm(false)}
                  >
                    Cancel
                  </Button>
                </div>
              ) : (
                <Button
                  variant="outline"
                  size="sm"
                  className="text-muted-foreground hover:text-destructive hover:border-destructive"
                  onClick={() => setClearAllConfirm(true)}
                >
                  <Trash2 className="h-4 w-4 mr-2" />
                  Clear All
                </Button>
              )}
            </div>
            {sortedDates
              .filter((dateKey) =>
                conversations?.search?.length === 0
                  ? true
                  : groupedConversations?.[dateKey]?.some((doc) =>
                    doc?.title
                      .toLowerCase()
                      .includes(conversations?.search?.toLowerCase() || "")
                  )
              )
              .map((dateKey) => (
                <div key={dateKey} className="flex flex-col gap-3">
                  <p className="text-xs text-muted-foreground select-none font-medium">
                    {moment(dateKey).format("ddd, MMM D")}
                  </p>
                  <div className="grid grid-cols-1 gap-3">
                    {groupedConversations[dateKey].map((doc) => (
                      <Card
                        key={doc.id}
                        className="shadow-none select-none p-4 gap-0 group relative transition-all !bg-black/5 dark:!bg-white/5 hover:!border-primary/50 cursor-pointer"
                        onClick={() => navigate(`/chats/view/${doc.id}`)}
                      >
                        <div className="flex items-center justify-between">
                          <p className="line-clamp-1 text-sm mr-8">
                            {doc.title}
                          </p>
                          <div className="flex items-center gap-1">
                            <Badge variant="outline" className="text-xs">
                              {doc.messages.length} messages
                            </Badge>
                            <Badge variant="outline" className="text-xs">
                              {moment(doc.updatedAt).format("hh:mm A")}
                            </Badge>
                            {/* Trash button - appears on hover */}
                            <button
                              className="ml-2 p-1 rounded opacity-0 group-hover:opacity-100 hover:bg-destructive/10 hover:text-destructive transition-opacity"
                              onClick={(e) => {
                                e.stopPropagation();
                                conversations.handleDeleteConfirm(doc.id);
                              }}
                              title="Delete conversation"
                            >
                              <Trash2 className="h-4 w-4" />
                            </button>
                          </div>
                        </div>
                      </Card>
                    ))}
                  </div>
                </div>
              ))}
          </div>
        )}

        {/* Delete Confirmation Dialog */}
        <DeleteConfirmationDialog
          deleteConfirm={conversations.deleteConfirm}
          cancelDelete={conversations.cancelDelete}
          confirmDelete={conversations.confirmDelete}
        />
      </>
    </PageLayout>
  );
};

export default Dashboard;
</file>

<file path="AutoVision/Cognitive-Automation/pluely/src/pages/context/index.tsx">
import { useState, useEffect } from "react";
import { Header, Button, Selection } from "@/components";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Slider } from "@/components/ui/slider";
import {
    Dialog,
    DialogContent,
    DialogDescription,
    DialogFooter,
    DialogHeader,
    DialogTitle,
} from "@/components/ui/dialog";
import { useApp } from "@/contexts";
import { useModelTester, TestResult } from "@/hooks/useModelTester";
import {
    getProfiles,
    saveProfile,
    getProfileForModel,
    setProfileForModel,
    deleteProfile,
    getGlobalDefaultProfileId,
    setGlobalDefaultProfileId,
} from "@/lib/storage/model-profiles.storage";
import { getProviderDefaults } from "@/config";
import { ModelProfile } from "@/types";
import {
    FlaskConicalIcon,
    Loader2Icon,
    CheckCircle2Icon,
    XCircleIcon,
    EyeIcon,
    AlertTriangleIcon,
    SaveIcon,
    RefreshCwIcon,
    Trash2Icon,
    TimerIcon,
    PencilIcon,
    StarIcon,
} from "lucide-react";
import curl2Json from "@bany/curl-to-json";
import { fetch as tauriFetch } from "@tauri-apps/plugin-http";

/**
 * Context Management Page
 * Configure how Pluely handles AI context, model capabilities, and conversation history.
 */
const Context = () => {
    const { allAiProviders, selectedAIProvider } = useApp();
    const tester = useModelTester();

    // State
    const [selectedProvider, setSelectedProvider] = useState<string>(
        selectedAIProvider?.provider || ""
    );
    const [selectedModel, setSelectedModel] = useState<string>(
        selectedAIProvider?.variables?.model || ""
    );
    const [fetchedModels, setFetchedModels] = useState<string[]>([]);
    const [isLoadingModels, setIsLoadingModels] = useState(false);
    const [profiles, setProfiles] = useState<ModelProfile[]>([]);
    const [selectedProfileId, setSelectedProfileId] = useState<string>("");
    const [customProfileName, setCustomProfileName] = useState("");
    const [showSaveDialog, setShowSaveDialog] = useState(false);
    const [showConfirm, setShowConfirm] = useState(false);

    // Profile editor state
    const [editingProfile, setEditingProfile] = useState<ModelProfile | null>(null);
    const [editName, setEditName] = useState("");
    const [editVision, setEditVision] = useState(true);
    const [editContext, setEditContext] = useState(32000);

    // Test delay settings
    const [testDelay, setTestDelay] = useState(30); // seconds between tests

    // Global default profile
    const [globalDefaultId, setGlobalDefaultId] = useState(getGlobalDefaultProfileId());

    // Load profiles on mount
    useEffect(() => {
        setProfiles(getProfiles());
        setGlobalDefaultId(getGlobalDefaultProfileId());
    }, []);

    // Sync with global selection
    useEffect(() => {
        if (selectedAIProvider?.provider) {
            setSelectedProvider(selectedAIProvider.provider);
            if (selectedAIProvider.variables?.model) {
                setSelectedModel(selectedAIProvider.variables.model);
            }
        }
    }, [selectedAIProvider]);

    // Fetch models when provider changes
    useEffect(() => {
        if (selectedProvider) {
            fetchModelsForProvider(selectedProvider);
            const profileId = getProfileForModel(selectedModel);
            setSelectedProfileId(profileId);
        }
    }, [selectedProvider]);

    // Fetch available models for a provider
    const fetchModelsForProvider = async (providerId: string) => {
        setIsLoadingModels(true);
        try {
            const provider = allAiProviders?.find((p) => p?.id === providerId);
            if (!provider) return;

            let baseUrl = "";
            let apiKey = "";

            try {
                const curlJson = curl2Json(provider.curl);
                const url = curlJson.url;

                if (url.includes("/chat/completions")) {
                    baseUrl = url.split("/chat/completions")[0];
                } else if (url.includes("/completions")) {
                    baseUrl = url.split("/completions")[0];
                } else {
                    const urlObj = new URL(url);
                    baseUrl = `${urlObj.protocol}//${urlObj.host}/v1`;
                }

                apiKey = provider.variables?.API_KEY || provider.variables?.api_key || "";

                if (!apiKey && curlJson.header) {
                    const authHeader = curlJson.header["Authorization"];
                    if (authHeader && authHeader.includes("Bearer ")) {
                        const parts = authHeader.split("Bearer ");
                        if (parts.length > 1 && !parts[1].includes("{{")) {
                            apiKey = parts[1];
                        }
                    }
                }
            } catch (e) {
                console.warn("Failed to parse cURL for model fetching", e);
                if (providerId === "lm-studio") baseUrl = "http://localhost:1234/v1";
            }

            if (!baseUrl) return;

            const modelsUrl = `${baseUrl}/models`;
            const headers: Record<string, string> = { "Content-Type": "application/json" };
            if (apiKey && !apiKey.includes("{{")) {
                headers["Authorization"] = `Bearer ${apiKey}`;
            }

            const isLocal = modelsUrl.includes("localhost") || modelsUrl.includes("127.0.0.1");
            const fetchFn = isLocal ? fetch : tauriFetch;

            const response = await fetchFn(modelsUrl, { method: "GET", headers });
            if (response.ok) {
                const data = await response.json();
                const models = data.data?.map((m: any) => m.id) || [];
                setFetchedModels(models);
                if (models.length > 0 && !selectedModel) {
                    setSelectedModel(models[0]);
                }
            }
        } catch (error) {
            console.error("Error fetching models:", error);
        } finally {
            setIsLoadingModels(false);
        }
    };

    // Get provider name for display
    const getProviderName = (providerId: string): string => {
        const provider = allAiProviders?.find((p) => p?.id === providerId);
        return provider?.name || providerId;
    };

    // Get current capabilities (from profile or estimate)
    const getCurrentCapabilities = (): TestResult | null => {
        if (tester.result) return tester.result;

        const defaults = getProviderDefaults(selectedProvider);
        return {
            supportsVision: defaults.vision,
            contextWindow: defaults.context,
            testedAt: 0,
            isEstimate: true,
        };
    };

    // Confirm and run test with delay
    const confirmTest = async () => {
        setShowConfirm(false);
        if (selectedProvider && selectedModel) {
            // Pass the delay to the tester (we'll implement this)
            await tester.runFullTest(selectedProvider, selectedModel, testDelay);
        }
    };

    // Save test result as profile
    const handleSaveProfile = () => {
        if (!tester.result || !customProfileName.trim()) return;

        const newProfile: ModelProfile = {
            id: `custom-${Date.now()}`,
            name: customProfileName.trim(),
            supportsVision: tester.result.supportsVision,
            contextWindow: tester.result.contextWindow,
        };

        saveProfile(newProfile);
        setProfileForModel(selectedModel, newProfile.id);
        setProfiles(getProfiles());
        setSelectedProfileId(newProfile.id);
        setShowSaveDialog(false);
        setCustomProfileName("");
    };


    // Delete a profile
    const handleDeleteProfile = (profileId: string) => {
        deleteProfile(profileId);
        setProfiles(getProfiles());
        if (selectedProfileId === profileId) {
            setSelectedProfileId("");
        }
    };

    // Open profile for editing
    const handleEditProfile = (profile: ModelProfile) => {
        setEditingProfile(profile);
        setEditName(profile.name);
        setEditVision(profile.supportsVision);
        setEditContext(profile.contextWindow);
    };

    // Save edited profile
    const handleSaveEditedProfile = () => {
        if (!editingProfile || !editName.trim()) return;

        const updatedProfile: ModelProfile = {
            ...editingProfile,
            name: editName.trim(),
            supportsVision: editVision,
            contextWindow: editContext,
        };

        saveProfile(updatedProfile);
        setProfiles(getProfiles());
        setEditingProfile(null);
    };

    const capabilities = getCurrentCapabilities();

    return (
        <div className="flex flex-col h-full overflow-y-auto">
            <div className="space-y-6 pb-10 pt-6">
                {/* Page Header */}
                <Header
                    title="🧠 Model Profiles"
                    description="Configure how Pluely handles history and images for different models to prevent crashes and save tokens."
                    isMainTitle
                />

                {/* Section 1: Global Default Profile */}
                <Card className="p-4 space-y-4">
                    <div className="flex items-center gap-2">
                        <StarIcon className="size-4 text-yellow-500" />
                        <h3 className="font-semibold">Global Default Profile</h3>
                    </div>
                    <p className="text-sm text-muted-foreground">
                        This profile is used when a model doesn't have a specific profile assigned.
                        Select from the built-in or custom profiles below.
                    </p>

                    <div className="flex items-center gap-4">
                        <Selection
                            selected={globalDefaultId}
                            options={profiles.map((p) => ({
                                label: p.name,
                                value: p.id,
                            }))}
                            placeholder="Select default profile"
                            onChange={(v) => {
                                setGlobalDefaultId(v);
                                setGlobalDefaultProfileId(v);
                            }}
                        />
                        {profiles.find(p => p.id === globalDefaultId) && (
                            <div className="text-sm text-muted-foreground">
                                {profiles.find(p => p.id === globalDefaultId)?.supportsVision ? "✅ Vision" : "❌ No Vision"} |
                                {" "}{profiles.find(p => p.id === globalDefaultId)?.contextWindow.toLocaleString()} tokens
                            </div>
                        )}
                    </div>
                </Card>


                {/* Section 2: Model Testing (Beta) */}
                <Card className="p-4 space-y-4">
                    <div className="flex items-center gap-2">
                        <FlaskConicalIcon className="size-4 text-primary" />
                        <h3 className="font-semibold">Model Testing</h3>
                        <Badge variant="outline" className="text-xs">Beta</Badge>
                    </div>
                    <p className="text-sm text-muted-foreground">
                        Test a specific model's capabilities by sending probe requests.
                    </p>

                    {/* Provider & Model Selection */}
                    <div className="grid grid-cols-2 gap-4">
                        <div className="space-y-2">
                            <label className="text-sm font-medium">Provider</label>
                            <Selection
                                selected={selectedProvider}
                                options={allAiProviders?.map((p) => ({
                                    label: getProviderName(p?.id || ""),
                                    value: p?.id || "",
                                })) || []}
                                placeholder="Select provider"
                                onChange={setSelectedProvider}
                            />
                        </div>
                        <div className="space-y-2">
                            <label className="text-sm font-medium">Model</label>
                            <div className="flex gap-2">
                                <div className="flex-1">
                                    <Selection
                                        selected={selectedModel}
                                        options={fetchedModels.map((m) => ({ label: m, value: m }))}
                                        placeholder={isLoadingModels ? "Loading..." : "Select model"}
                                        isLoading={isLoadingModels}
                                        onChange={setSelectedModel}
                                    />
                                </div>
                                <Button
                                    variant="outline"
                                    size="icon"
                                    onClick={() => selectedProvider && fetchModelsForProvider(selectedProvider)}
                                    disabled={!selectedProvider || isLoadingModels}
                                    title="Refresh available models"
                                    className="h-11 w-11 shrink-0"
                                >
                                    {isLoadingModels ? (
                                        <Loader2Icon className="size-4 animate-spin" />
                                    ) : (
                                        <RefreshCwIcon className="size-4" />
                                    )}
                                </Button>
                            </div>
                        </div>
                    </div>

                    {/* Test Delay Slider */}
                    <div className="space-y-2 p-3 rounded-lg bg-muted/30">
                        <div className="flex items-center justify-between">
                            <div className="flex items-center gap-2">
                                <TimerIcon className="size-4 text-muted-foreground" />
                                <label className="text-sm font-medium">Test Delay</label>
                            </div>
                            <span className="text-sm font-mono">{testDelay}s</span>
                        </div>
                        <Slider
                            value={[testDelay]}
                            onValueChange={(v) => setTestDelay(v[0])}
                            min={5}
                            max={120}
                            step={5}
                            className="w-full"
                        />
                        <p className="text-xs text-muted-foreground">
                            Wait time between tests to avoid rate limits. Higher = safer but slower.
                        </p>
                    </div>

                    {/* Current Capabilities Display */}
                    {capabilities && (
                        <div className="p-3 rounded-lg bg-muted/50 space-y-2">
                            <div className="flex items-center justify-between">
                                <span className="text-sm font-medium">Current Capabilities</span>
                                {capabilities.isEstimate ? (
                                    <Badge variant="secondary" className="text-xs">
                                        <AlertTriangleIcon className="size-3 mr-1" />
                                        Estimated
                                    </Badge>
                                ) : (
                                    <Badge variant="default" className="text-xs bg-green-500/20 text-green-500">
                                        <CheckCircle2Icon className="size-3 mr-1" />
                                        Tested
                                    </Badge>
                                )}
                            </div>
                            <div className="grid grid-cols-2 gap-4 text-sm">
                                <div className="flex items-center gap-2">
                                    <EyeIcon className="size-4 text-muted-foreground" />
                                    <span>Vision:</span>
                                    {capabilities.supportsVision ? (
                                        <CheckCircle2Icon className="size-4 text-green-500" />
                                    ) : (
                                        <XCircleIcon className="size-4 text-red-500" />
                                    )}
                                </div>
                                <div className="flex items-center gap-2">
                                    <span className="text-muted-foreground">Context:</span>
                                    <span className="font-mono">
                                        {capabilities.contextWindow.toLocaleString()} tokens
                                    </span>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Test Progress */}
                    {tester.isLoading && (
                        <div className="flex items-center gap-2 text-sm text-muted-foreground">
                            <Loader2Icon className="size-4 animate-spin" />
                            {tester.testProgress}
                        </div>
                    )}

                    {/* Error Display */}
                    {tester.error && (
                        <div className="p-3 rounded-lg bg-destructive/10 text-destructive text-sm">
                            {tester.error}
                        </div>
                    )}

                    {/* Action Buttons */}
                    <div className="flex items-center gap-2">
                        <Button
                            onClick={() => setShowConfirm(true)}
                            disabled={!selectedProvider || !selectedModel || tester.isLoading}
                            className="gap-2"
                        >
                            <FlaskConicalIcon className="size-4" />
                            Test Capabilities
                        </Button>

                        {tester.result && !tester.result.isEstimate && (
                            <Button
                                variant="outline"
                                onClick={() => setShowSaveDialog(true)}
                                className="gap-2"
                            >
                                <SaveIcon className="size-4" />
                                Save as Profile
                            </Button>
                        )}
                    </div>
                </Card>

                {/* Section 3: Model Profiles */}
                <Card className="p-4 space-y-4">
                    <div className="flex items-center justify-between">
                        <div className="flex items-center gap-2">
                            <h3 className="font-semibold">Model Profiles</h3>
                            <Badge variant="secondary" className="text-xs">{profiles.length}</Badge>
                        </div>
                    </div>
                    <p className="text-sm text-muted-foreground">
                        Saved capability profiles for quick assignment to models.
                    </p>

                    {profiles.length > 0 ? (
                        <div className="border rounded-lg overflow-hidden">
                            <table className="w-full text-sm">
                                <thead className="bg-muted/50">
                                    <tr>
                                        <th className="text-left p-3 font-medium">Name</th>
                                        <th className="text-center p-3 font-medium">Vision</th>
                                        <th className="text-right p-3 font-medium">Context</th>
                                        <th className="text-right p-3 font-medium">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {profiles.map((profile) => (
                                        <tr key={profile.id} className="border-t hover:bg-muted/30 transition-colors">
                                            <td className="p-3">
                                                {profile.name}
                                                {profile.isDefault && (
                                                    <Badge variant="outline" className="ml-2 text-xs">Built-in</Badge>
                                                )}
                                            </td>
                                            <td className="p-3 text-center">
                                                {profile.supportsVision ? (
                                                    <CheckCircle2Icon className="size-4 text-green-500 mx-auto" />
                                                ) : (
                                                    <XCircleIcon className="size-4 text-red-500 mx-auto" />
                                                )}
                                            </td>
                                            <td className="p-3 text-right font-mono">
                                                {profile.contextWindow.toLocaleString()}
                                            </td>
                                            <td className="p-3 text-right">
                                                <div className="flex items-center justify-end gap-1">
                                                    {/* Star - indicates/sets as global default */}
                                                    <Button
                                                        variant="ghost"
                                                        size="icon"
                                                        onClick={() => {
                                                            setGlobalDefaultId(profile.id);
                                                            setGlobalDefaultProfileId(profile.id);
                                                        }}
                                                        className={`h-8 w-8 ${globalDefaultId === profile.id ? "text-yellow-500" : "text-muted-foreground hover:text-yellow-500"}`}
                                                        title={globalDefaultId === profile.id ? "Current default" : "Set as global default"}
                                                    >
                                                        <StarIcon className={`size-4 ${globalDefaultId === profile.id ? "fill-yellow-500" : ""}`} />
                                                    </Button>
                                                    {/* Edit button - only for custom profiles */}
                                                    {!profile.isDefault && (
                                                        <Button
                                                            variant="ghost"
                                                            size="icon"
                                                            onClick={() => handleEditProfile(profile)}
                                                            className="h-8 w-8"
                                                            title="Edit profile"
                                                        >
                                                            <PencilIcon className="size-3" />
                                                        </Button>
                                                    )}
                                                    {/* Delete button - only for custom profiles */}
                                                    {!profile.isDefault && (
                                                        <Button
                                                            variant="ghost"
                                                            size="icon"
                                                            onClick={() => handleDeleteProfile(profile.id)}
                                                            className="h-8 w-8 text-destructive hover:text-destructive"
                                                            title="Delete profile"
                                                        >
                                                            <Trash2Icon className="size-3" />
                                                        </Button>
                                                    )}
                                                </div>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    ) : (
                        <div className="p-8 text-center text-muted-foreground border rounded-lg border-dashed">
                            No profiles yet. Test a model and save the results.
                        </div>
                    )}
                </Card>

                {/* Confirmation Dialog */}
                <Dialog open={showConfirm} onOpenChange={setShowConfirm}>
                    <DialogContent>
                        <DialogHeader>
                            <DialogTitle>⚠️ Test Model Capabilities</DialogTitle>
                            <DialogDescription className="space-y-2">
                                <p>This will send test requests to verify:</p>
                                <ul className="list-disc list-inside text-sm">
                                    <li>Vision support (small image test)</li>
                                    <li>Context window (progressive test)</li>
                                </ul>
                                <p className="font-medium text-yellow-600 dark:text-yellow-500">
                                    ⏱️ Tests will run with {testDelay}s delay between each
                                </p>
                                <p className="text-yellow-600 dark:text-yellow-500">
                                    💰 Estimated cost: varies by model (could be $0.01-$0.50)
                                </p>
                            </DialogDescription>
                        </DialogHeader>
                        <DialogFooter>
                            <Button variant="outline" onClick={() => setShowConfirm(false)}>
                                Cancel
                            </Button>
                            <Button onClick={confirmTest}>Run Test</Button>
                        </DialogFooter>
                    </DialogContent>
                </Dialog>

                {/* Save Profile Dialog */}
                <Dialog open={showSaveDialog} onOpenChange={setShowSaveDialog}>
                    <DialogContent>
                        <DialogHeader>
                            <DialogTitle>Save as Profile</DialogTitle>
                            <DialogDescription>
                                Save these capabilities as a reusable profile.
                            </DialogDescription>
                        </DialogHeader>
                        <div className="space-y-4">
                            <div className="space-y-2">
                                <label className="text-sm font-medium">Profile Name</label>
                                <Input
                                    placeholder="e.g., My Local Vision Model"
                                    value={customProfileName}
                                    onChange={(e) => setCustomProfileName(e.target.value)}
                                />
                            </div>
                            {tester.result && (
                                <div className="text-sm text-muted-foreground">
                                    Vision: {tester.result.supportsVision ? "Yes" : "No"} |
                                    Context: {tester.result.contextWindow.toLocaleString()} tokens
                                </div>
                            )}
                        </div>
                        <DialogFooter>
                            <Button variant="outline" onClick={() => setShowSaveDialog(false)}>
                                Cancel
                            </Button>
                            <Button onClick={handleSaveProfile} disabled={!customProfileName.trim()}>
                                Save Profile
                            </Button>
                        </DialogFooter>
                    </DialogContent>
                </Dialog>

                {/* Edit Profile Dialog */}
                <Dialog open={!!editingProfile} onOpenChange={(open) => !open && setEditingProfile(null)}>
                    <DialogContent>
                        <DialogHeader>
                            <DialogTitle>Edit Profile</DialogTitle>
                            <DialogDescription>
                                Modify the profile settings.
                            </DialogDescription>
                        </DialogHeader>
                        <div className="space-y-4">
                            <div className="space-y-2">
                                <label className="text-sm font-medium">Profile Name</label>
                                <Input
                                    placeholder="Profile name"
                                    value={editName}
                                    onChange={(e) => setEditName(e.target.value)}
                                />
                            </div>
                            <div className="space-y-2">
                                <label className="text-sm font-medium">Vision Support</label>
                                <Selection
                                    selected={editVision ? "true" : "false"}
                                    options={[
                                        { label: "Enabled", value: "true" },
                                        { label: "Disabled", value: "false" },
                                    ]}
                                    onChange={(v) => setEditVision(v === "true")}
                                />
                            </div>
                            <div className="space-y-2">
                                <label className="text-sm font-medium">Context Window (tokens)</label>
                                <Input
                                    type="number"
                                    placeholder="e.g., 32000"
                                    value={editContext}
                                    onChange={(e) => setEditContext(Number(e.target.value))}
                                />
                            </div>
                        </div>
                        <DialogFooter>
                            <Button variant="outline" onClick={() => setEditingProfile(null)}>
                                Cancel
                            </Button>
                            <Button onClick={handleSaveEditedProfile} disabled={!editName.trim()}>
                                Save Changes
                            </Button>
                        </DialogFooter>
                    </DialogContent>
                </Dialog>
            </div>
        </div>
    );
};

export default Context;
</file>

