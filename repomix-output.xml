                                                                                {prompt.name}
                                                                            </SelectItem>
                                                                        ))}
                                                                    </SelectContent>
                                                                </Select>
                                                            </div>
                                                            <div className="space-y-2">
                                                                <Label>User Prompt (Optional Context)</Label>
                                                                <Textarea
