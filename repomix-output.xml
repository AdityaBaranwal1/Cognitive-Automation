                                                                        <SelectTrigger>
                                                                            <SelectValue placeholder="Select Provider" />
                                                                        </SelectTrigger>
                                                                        <SelectContent>
                                                                            {allAiProviders.map(p => (
                                                                                <SelectItem key={p.id} value={p.id || "unknown"}>
                                                                                    {p.isCustom ? (p.id) : (p.id || "Unknown")}
